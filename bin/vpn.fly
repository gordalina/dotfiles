#!/usr/bin/env bash
set -euo pipefail

APP_NAME="gordalina-ts-exit-node"

reset="\033[0m"
gray="\033[1;30m"
green="\033[0;32m"
yellow="\033[1;33m"
white="\033[1;37m"

IMAGE="registry.fly.io/${APP_NAME}:latest"
MACHINE_ID=""
REGION="${1:-}"
EXIT_NODE_NAME="exit-node-${REGION}"
SETUP=

usage() {
  cat <<EOF
Usage: vpn <fly-region>
       vpn deploy
       vpn setup
       vpn regions

Commands:
  deploy    Build and push the image, update all machines, and stop them
  setup     Show setup instructions for configuring Tailscale and Fly.io
  regions   List available Fly.io regions
  <region>  Start an exit node in the specified region

Example:
  vpn lax
  vpn deploy
  vpn regions
EOF

  exit 1
}

setup() {
  printf "%b" $"
${green}Fly machines as Tailscale exit nodes${gray}

1. Add the following to tailscale policy:
${white}
    "tagOwners":     {"tag:exit-node": ["autogroup:admin"]},
    "autoApprovers": {"exitNode": ["tag:exit-node"]},
${gray}
2. And create an auth key with: ${white}
  - tag ${yellow}exit-node${reset}
  - ephemeral
  - use as exit node
  - reusable authentication
  - expiry with 90days ${gray}

3. Update the secret in fly with your auth key:
${white}
    fly secrets set TS_AUTHKEY="tskey-auth-..." -a \$APP_NAME
${gray}
4. Build and deploy the image:
${white}
    vpn deploy
${gray}
5. Run as needed:
${white}
    vpn <region>
${gray}
${green}
Script usage
${reset}
"
  usage
}

deploy() {
  trap "rm -rf Dockerfile" EXIT

  cat > "Dockerfile" <<'DOCKERFILE'
FROM tailscale/tailscale:latest

RUN cat <<'EOF' > /entrypoint.sh && chmod +x /entrypoint.sh
#!/bin/sh

export TS_HOSTNAME="exit-node-${FLY_REGION}"

sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

exec /usr/local/bin/containerboot
EOF

ENTRYPOINT ["/entrypoint.sh"]
DOCKERFILE

  echo -e "${yellow}deploy${reset}: Building and pushing image..."
  fly deploy --build-only --image-label=latest --push -a "$APP_NAME"

  echo -e "${yellow}deploy${reset}: Updating image on all machines..."
  fly image update --image "registry.fly.io/$APP_NAME:latest" --yes -a "$APP_NAME"

  echo -e "${yellow}deploy${reset}: Stopping all machines..."
  for machine_id in $(fly machine list --json -a "$APP_NAME" | jq -r '.[].id'); do
    fly machine stop "$machine_id" -a "$APP_NAME"
  done

  echo -e "${green}deploy${reset}: Done!"
}

pick_existing_machine() {
  local json
  json="$(fly machine list -a "$APP_NAME" --json)"

  MACHINE_ID="$(jq -r --arg r "$REGION" 'map(select(.region == $r and .state != "created")) | .[0].id // ""' <<<"$json")"

  [[ -n "$MACHINE_ID" && "$MACHINE_ID" != "null" ]]
}

machine_has_volume() {
  local json
  json="$(fly volumes list -a "$APP_NAME" --json)"

  VOLUME_ID="$(jq -r --arg r "$REGION" 'map(select(.region == $r and .name == "ts_data")) | .[0].id // ""' <<<"$json")"

  [[ -n "$VOLUME_ID" && "$VOLUME_ID" != "null" ]]
}

create_machine_in_region() {
  if ! machine_has_volume; then
    echo -e "${yellow}$REGION${reset}:${reset} Creating volume for tailscale state"
    fly volumes create ts_data -a "$APP_NAME" -s 1 -r "$REGION" --yes
  fi

  echo -e "${yellow}$REGION${reset}:${reset} Creating machine..."
  fly machine create $IMAGE \
    --app="$APP_NAME" \
    --region="$REGION" \
    --volume=ts_data:/var/lib/tailscale \
    --env="TS_ACCEPT_DNS=true" \
    --env="TS_EXTRA_ARGS=--advertise-exit-node --advertise-tags=tag:exit-node" \
    --env="TS_USERSPACE=false" \
    --env="TS_STATE_DIR=/var/lib/tailscale"

  local timeout=60
  local deadline=$((SECONDS + $timeout))

  while (( SECONDS < deadline )); do
    if pick_existing_machine; then
      return 0
    fi
    sleep 0.5
  done
}

wait_for_exit_node_visible() {
  local timeout=60
  local deadline=$((SECONDS + $timeout))

  while (( SECONDS < deadline )); do
    if tailscale status 2>/dev/null | grep -qF "$EXIT_NODE_NAME"; then
      return 0
    fi
    sleep 0.5
  done

  echo -e "${yellow}$REGION${reset}:${reset} Timed out waiting for tailscale to see node ${green}$EXIT_NODE_NAME${reset} within ${timeout}s." >&2
  exit 1
}

teardown() {
  echo -e "${yellow}$REGION${reset}:${reset} Tear down: disable exit node and stopping Fly machine."

  tailscale set --exit-node=
  fly machine stop "$MACHINE_ID" -a "$APP_NAME"

  exit 0
}

bringup() {
  trap teardown EXIT QUIT TERM
  trap "echo CTRL+C" INT

  if ! pick_existing_machine; then
    create_machine_in_region
  else
    echo -e "${yellow}$REGION${reset}:${reset} Found machine in ${green}$MACHINE_ID${reset}"
  fi

  fly machine start "$MACHINE_ID" -a "$APP_NAME" #>/dev/null

  tailscale set --accept-dns=true

  echo -e "${yellow}$REGION${reset}:${reset} Waiting for exit node to appear in tailscale as ${green}$EXIT_NODE_NAME${reset}."
  wait_for_exit_node_visible
  tailscale set --exit-node="$EXIT_NODE_NAME" --exit-node-allow-lan-access=true #>/dev/null

  ip_address="$(curl -s 'https://api.ipify.org')"

  echo -e "${yellow}$REGION${reset}:${reset} Exit node is configured with ip address ${green}${ip_address}${reset}"
  echo "Press Ctrl+C to shut everything down."

  while true; do sleep 3600; done
}

case "${1:-}" in
  deploy)
    deploy
    ;;

  setup)
    setup
    ;;

  regions)
    fly platform regions
    ;;

  "")
    usage
    ;;

  *)
    bringup
    ;;
esac
