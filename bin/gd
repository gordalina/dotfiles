#!/usr/bin/env bash
git rev-parse --git-dir > /dev/null 2>&1 || { echo "You are not in a git repository"; exit 1; }

selected=$(git -c color.status=always status --short |
    fzf "$@" -m --ansi --nth 2..,.. \
        --color 'hl:-1:underline,hl+:-1:underline:reverse' \
        --preview 'd=$(DFT_COLOR=always git diff -- {-1} | sed 1d); if [ -n "$d" ]; then echo "$d"; elif [ -d {-1} ]; then find {-1}; else cat {-1}; fi | head -500' \
        --preview-window 'up,60%,border-bottom' |
    cut -c4- | sed 's/.* -> //')

if [ -n "$selected" ]; then
    for prog in $selected; do
        $EDITOR "$prog"
    done
fi
