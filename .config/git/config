[user]
    name = Samuel Gordalina
    email = samuel.gordalina@gmail.com
    signingKey = agent

[core]
    sshCommand = ~/.config/git/ssh.sh

[commit]
    gpgSign = true

[difftool]
    prompt = false

[pager]
    difftool = true

[diff]
    external = difft
    tool = difftastic

[tag]
    gpgSign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile =  ~/.config/git/allowed_signers
    program = ~/.config/git/sign.sh

[alias]
    unstash = "stash pop"

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[push]
    autoSetupRemote = true
    
[rerere]
	enabled = true
